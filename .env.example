# ==========================================
# 企业微信 LongCat AI 自动化服务 环境变量配置模板
# 复制本文件为 .env 并填入实际 API Key 即可
# ==========================================

# 1. LongCat 大模型 API 配置 (https://api.longcat.chat)
LONGCAT_API_KEY=your_longcat_api_key_here
LONGCAT_BASE_URL=https://api.longcat.chat/openai/v1
LONGCAT_MODEL=LongCat-2.5-Preview

# 2. 智谱 GLM 视觉自愈与记忆蒸馏 API (https://open.bigmodel.cn)
GLM_API_KEY=your_glm_api_key_here
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4v-flash
